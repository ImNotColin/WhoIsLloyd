// schema.prisma — the whole business in eight models: one pilot, his
// clients, their bookings, and the footage that pays for the propellers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One table for both the admin and clients, separated by role. The admin
/// is seeded; clients are created by the admin, never by self-signup.
model User {
  id                Int          @id @default(autoincrement())
  email             String       @unique // stored lowercased by the routes
  password          String // bcrypt hash, 12 rounds — never plaintext, never logged
  name              String
  role              Role         @default(CLIENT)
  projectLabel      String? // e.g. "Smith Wedding — June" in the portal header
  notes             String?
  mustResetPassword Boolean      @default(true) // temporary password still in effect
  createdAt         DateTime     @default(now())
  files             ClientFile[]
}

enum Role {
  ADMIN
  CLIENT
}

/// A booked shoot. No relation to User on purpose — booking is public and
/// most bookers never get a portal account, so we keep contact info inline.
model Booking {
  id          Int           @id @default(autoincrement())
  clientName  String
  email       String
  phone       String
  service     ServiceType
  slot        SlotType
  date        DateTime // UTC midnight, meaning "this calendar day in Texas" (see dateUtils.js)
  notes       String
  status      BookingStatus @default(PENDING)
  gcalEventId String? // Google Calendar event id, if creation succeeded
  createdAt   DateTime      @default(now())
}

enum ServiceType {
  REAL_ESTATE
  EVENTS
  CONSTRUCTION
  WEDDINGS
}

/// Two slots a day, full stop. The drone has more batteries than Colin
/// has daylight.
enum SlotType {
  AM
  PM
}

/// CANCELLED rows are kept, not deleted — they release their slot but
/// preserve the paper trail.
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Admin-declared no-fly days: holidays, weather, deer season. Unique date
/// keeps double-blocking idempotent.
model BlockedDate {
  id   Int      @id @default(autoincrement())
  date DateTime @unique
}

/// Singleton row (id is always 1): which weekdays accept bookings.
/// Defaults are weekends-only — the original day-job-friendly schedule.
model AvailabilitySettings {
  id          Int     @id @default(1)
  mondayOn    Boolean @default(false)
  tuesdayOn   Boolean @default(false)
  wednesdayOn Boolean @default(false)
  thursdayOn  Boolean @default(false)
  fridayOn    Boolean @default(false)
  saturdayOn  Boolean @default(true)
  sundayOn    Boolean @default(true)
}

/// One clip on the public showreel. Paths are either local /storage files
/// or remote placeholder URLs from the seed; routes handle both.
model PortfolioItem {
  id            Int         @id @default(autoincrement())
  title         String
  category      ServiceType
  thumbnailPath String
  videoPath     String
  displayOrder  Int         @default(0) // lower numbers float to the top
  createdAt     DateTime    @default(now())
}

/// Kind words, hand-entered by the admin. `visible` hides a quote without
/// deleting it.
model Testimonial {
  id         Int         @id @default(autoincrement())
  clientName String
  service    ServiceType
  quote      String
  rating     Int         @default(5)
  visible    Boolean     @default(true)
  createdAt  DateTime    @default(now())
}

/// A delivered file in a client's portal. fileSize is BigInt because drone
/// deliverables blew past Int32's 2GB ceiling on roughly day one. Deleting
/// the user cascades these rows (disk cleanup is the route's job).
model ClientFile {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename   String // original name, shown to the client
  filePath   String // sanitized, randomized name on disk
  fileSize   BigInt
  uploadedAt DateTime @default(now())
}

/// The outtake reel. Publicly readable, admin-only writable, and only
/// discoverable by those who know where to click.
model Blooper {
  id        Int      @id @default(autoincrement())
  title     String
  videoPath String
  createdAt DateTime @default(now())
}

/// Singleton row (id is always 1): public contact info plus two private
/// fields. Defaults below ship the real business details so the site is
/// presentable before anyone touches the admin panel.
model SiteSettings {
  id                 Int     @id @default(1)
  phone              String  @default("(903) 520-9328")
  email              String  @default("DronesByColin@gmail.com")
  instagram          String  @default("@DronesByColin")
  businessHours      String  @default("By appointment — weekends preferred")
  part107Path        String? // FAA Part 107 license image, set via admin upload
  googleRefreshToken String? // Google Calendar OAuth2 refresh token — server-side only, never in any API response
}
