# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dronesbycolin"

# JWT — generate each with: openssl rand -base64 64
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (Gmail SMTP — use an App Password, NOT the account password.
# Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_USER="DronesByColin@gmail.com"
GMAIL_APP_PASSWORD=""

# Google Calendar (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://dronesbycolin.com/api/auth/google/callback"
GOOGLE_CALENDAR_ID="primary"

# App
PORT=3001
NODE_ENV=production
FRONTEND_URL="https://dronesbycolin.com"
STORAGE_PATH="/storage"

# Admin (seeded on first deploy — change the password immediately after login)
ADMIN_EMAIL="DronesByColin@gmail.com"
ADMIN_INITIAL_PASSWORD=""
